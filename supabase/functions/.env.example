# OPTIONAL. Each app normally sends its own Gemini key (x-gemini-key), so the function needs no secrets.
# Use this only if the project owner wants a server-side key for their own account.
# Copy to .env (same folder) and fill in. .env is git-ignored.
#
# Local:   supabase functions serve gemini --env-file supabase/functions/.env
# Deploy:  supabase secrets set --env-file supabase/functions/.env

# Used only for requests without x-gemini-key from these signed-in emails (comma-separated).
GEMINI_API_KEY=your-gemini-api-key
SERVER_KEY_EMAILS=you@example.com

# Optional model overrides
# GEMINI_FLASH_MODEL=gemini-3.8-flash
# GEMINI_EMBED_MODEL=gemini-embedding-2
