# Copy to .env (same folder) and fill in. .env is git-ignored.
#
# Local:   supabase functions serve gemini --env-file supabase/functions/.env
# Deploy:  supabase secrets set --env-file supabase/functions/.env

GEMINI_API_KEY=your-gemini-api-key

# Optional model overrides
# GEMINI_FLASH_MODEL=gemini-3.8-flash
# GEMINI_EMBED_MODEL=gemini-embedding-2
