// Copy to Secrets.xcconfig (git-ignored) and fill in from Supabase → Project Settings → API.
// Write the URL with $() between the slashes so xcconfig doesn't treat "//" as a comment.
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY
// Your Apple team ID (Xcode → Settings → Accounts), for running on a real iPhone.
DEVELOPMENT_TEAM = YOUR-TEAM-ID
